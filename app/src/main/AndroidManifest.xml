<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- magpie's Web UI is served on the phone itself and calls out to model
         providers, so it needs the network. WAKE_LOCK keeps the CPU alive
         while a gateway request is in flight. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮球 + 隐形保活小窗口：覆盖在其它应用上层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 9+：前台服务必须声明这个权限，否则 startForeground 直接
         SecurityException（targetSdk 28 也躲不开）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ 的通知权限：targetSdk 28 的包里系统默认给，写上是明白。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「忽略电池优化」按钮要把系统那个授权页拉起来 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 壳自更新（App 内下载 APK 后拉起安装器）需要请求安装未知应用（Android 8+） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shizuku：用户用 Shizuku/Sui 授权后，壳可以以 shell/root 身份执行命令
         （比如往 MIUI 省电策略数据库写「无限制」），不需要 App 本身有 root。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_magpie_bird"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:roundIcon="@drawable/ic_magpie_bird"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Magpie">

        <!-- 主界面：原生绘制，直连 magpie 的 HTTP 接口，不再是 WebView。
             入口仍然是 Launcher。 -->
        <activity
            android:name=".NativeHome"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 旧的 WebView 壳整个留着，从原生界面的 ⋮ 菜单进：插件安装、
             隐私脱敏、同步备份这些深度功能，网页才做得全。 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="@string/web_ui_title"
            android:parentActivityName=".NativeHome"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:label="@string/update_settings_title"
            android:parentActivityName=".NativeHome" />

        <!-- 更新页：问 GitHub（magpie 的发布清单）、下载新的 ELF、重启网关。
             拉的是二进制，不是 APK，所以不需要「安装未知应用」权限。 -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:label="@string/update_title"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:parentActivityName=".MainActivity" />

        <!-- No foregroundServiceType is declared on purpose: GatewayService
             calls the two-argument startForeground(), and targetSdk 28 keeps
             the Android 14 type requirements from applying. -->
        <service
            android:name=".GatewayService"
            android:exported="false" />

        <!-- 手写 FileProvider：给系统安装器提供已下载 APK 的 content:// 读取通道 -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.magpie.android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Shizuku 的 binder 接收器。Shizuku App 通过它把服务 binder 交给本 App；
             必须在 manifest 里声明，否则拿不到 binder、无法请求授权。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.magpie.android.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
